{:paths ["src" "common" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        http-kit/http-kit {:mvn/version "2.7.0"}
        metosin/reitit {:mvn/version "0.7.0"}
        hiccup/hiccup {:mvn/version "2.0.0-RC2"}
        cheshire/cheshire {:mvn/version "5.12.0"}
        dev.data-star.clojure/http-kit {:mvn/version "1.0.0-RC7"}
        metosin/malli {:mvn/version "0.16.4"}
        instaparse/instaparse {:mvn/version "1.5.0"}
        org.babashka/sci {:mvn/version "0.8.41"}
        ;; The reader, for TOP-LEVEL FORM BOUNDS in the extraction seam. clj-kondo's analysis
        ;; gives a defmethod no var-definition and no extent, so where one method's body stops is
        ;; readable nowhere else — and a column test cannot stand in, because a top-level form may
        ;; be indented. Pinned explicitly rather than inherited through clj-kondo's edamame: a
        ;; transitive version that moved would move attribution with it — and that read is
        ;; permissive by binding `*alias-map*`/`*data-readers*` to FUNCTIONS, which this version
        ;; consults by invocation.
        org.clojure/tools.reader {:mvn/version "1.3.4"}
        clj-kondo/clj-kondo {:mvn/version "2024.03.13"}
        ;; Cozo query engine. JNI native lib auto-downloads on first use to ~/.cozo_java_native_lib/.
        io.github.cozodb/cozo-clj {:mvn/version "0.7.5"}
        ;; 1.0.0+ gates its load-time auto-init behind `-Dclj-reload.auto-init=false`.
        ;; 0.7.1 runs `(init {:dirs (classpath-dirs)})` unconditionally at ns-load, which
        ;; walks the WHOLE consumer tree (node_modules, target, .git) before any fukan code
        ;; runs — an OOM on a real project. The cockpit inits its own scoped dirs in `go`.
        io.github.tonsky/clj-reload {:mvn/version "1.0.0"}}
 :aliases
 {:run {:main-opts ["-m" "fukan.core"]
        :extra-paths ["."]}
  ;; `-Dclj-reload.auto-init=false`: the cockpit inits clj-reload itself, with dirs scoped by
  ;; `:reload-dirs` (`fukan.repl/go`). Left on, clj-reload walks every classpath dir at ns-load
  ;; — and `.` is on the classpath here — scanning the whole tree for nothing. A consumer's
  ;; `:fukan` alias needs this same opt for the same reason; see the recipe in CLAUDE.md.
  :dev {:extra-paths ["." "dev"]
        :jvm-opts ["-Dclj-reload.auto-init=false"]}
  :test {:extra-paths ["test" "."]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.1"}}
         :jvm-opts ["-Dclj-reload.auto-init=false"]
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; Regenerate the clj-kondo instance-constructor hooks from a defstructure scan
  ;; (`tasks.kondo`, reachable via the `.` classpath root). Run after adding or
  ;; removing a structure; the `generated-config-file-is-current` test guards drift.
  :kondo {:main-opts ["-m" "tasks.kondo"]
          :extra-paths ["."]}
  ;; Full-classpath lint (ground truth): `clojure -M:lint --lint src common canvas test`.
  ;; Needs the `.` root so the defstructure `hooks.fukan.structure` hook resolves; a bare
  ;; `-M` (base :paths only) would miss it and flag false positives on defstructure bodies.
  :lint {:extra-paths ["."]
         :main-opts ["-m" "clj-kondo.main"]}
  ;; Run a CONSUMING PROJECT's own code against fukan — its region declaration, and whatever
  ;; reports it writes over the laws. It names nothing project-specific on purpose: the consumer
  ;; supplies its directory and its main namespace. A consumer keeps both in its own `.fukan/`,
  ;; with a `deps.edn` there so the directory joins this classpath as a :local/root, and invokes:
  ;;
  ;;   clojure -Sdeps '{:deps {<proj>/fukan-model {:local/root "<proj>/.fukan"}}}' \
  ;;           -M:consumer -m <its-report-ns> --src <proj>/src/main
  ;;
  ;; `clj-reload` is here because `fukan.repl/go` initialises it; `.` carries the canvas root.
  :consumer {:extra-paths ["."]
             :extra-deps {io.github.tonsky/clj-reload {:mvn/version "0.7.1"}}}

  :nrepl {:extra-paths ["." "dev"]
          :jvm-opts ["-Dclj-reload.auto-init=false"]
          :extra-deps {nrepl/nrepl       {:mvn/version "1.3.0"}
                       cider/cider-nrepl {:mvn/version "0.50.3"}}
          :main-opts  ["--main" "nrepl.cmdline"
                       "--middleware" "[cider.nrepl/cider-middleware]"
                       "--port" "7889"]}}}
